{
  "name": "dsh-workspace-combiner",
  "description": "DSH 工作区组合器：管理主目录与多个代码项目，自动识别 Java/Vue/React/Python/Go 及 pnpm/Turbo/Nx/Maven/Gradle Monorepo，把项目和内部包绝对路径注入会话并联动沙盒白名单。",
  "version": "0.8.2",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/host/index.js",
  "types": "lib/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/host/index.d.ts",
      "default": "./lib/host/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "CHANGELOG.zh.md",
    "docs/**"
  ],
  "dsh": {
    "host": "0.1.5-rc.2",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale",
        "sessions",
        "workspaces",
        "remote",
        "remote.directoryPicker"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke:code-index": "node --experimental-strip-types scripts/code-index-smoke.ts",
    "smoke:task-recommendation": "node --experimental-strip-types scripts/task-recommendation-smoke.ts",
    "smoke:task-verification": "node --experimental-strip-types scripts/task-verification-smoke.ts",
    "smoke:task-preflight": "node --experimental-strip-types scripts/task-preflight-smoke.ts",
    "smoke:project-defaults": "node --experimental-strip-types scripts/project-defaults-smoke.ts",
    "smoke:monorepo": "node --experimental-strip-types scripts/monorepo-smoke.ts",
    "smoke:on-demand-context": "node --experimental-strip-types scripts/on-demand-context-smoke.ts",
    "smoke:context-budget": "node --experimental-strip-types scripts/context-budget-smoke.ts",
    "smoke:diagnostics": "node --experimental-strip-types scripts/diagnostics-smoke.ts",
    "smoke:task-mode": "node --experimental-strip-types scripts/task-mode-smoke.ts"
  },
  "peerDependencies": {
    "@chaoset/sandbox-extra-roots": "^0.4.12",
    "@deepseek-ai/dsh-client-locale": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "cordis",
    "workspace",
    "multi-workspace",
    "工作区组合器"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ninglovegithub/dsh-workspace-combiner.git"
  },
  "homepage": "https://github.com/ninglovegithub/dsh-workspace-combiner#readme"
}
